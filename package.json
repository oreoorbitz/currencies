{
  "name": "currencies-mepto",
  "version": "1.0.0-mepto.1",
  "description": "Currencies.js extension for Shopify \u2014 Mepto-integrated, jQuery-free. Efficient drop-in for jquery.currencies.js.",
  "keywords": [
    "shopify",
    "currency",
    "currencies",
    "mepto",
    "jquery-free"
  ],
  "type": "module",
  "main": "dist/currencies.pkgd.js",
  "module": "dist/currencies.esm.js",
  "exports": {
    ".": {
      "import": "./dist/currencies.esm.js",
      "require": "./dist/currencies.pkgd.js"
    }
  },
  "files": [
    "dist",
    "src",
    "jquery.currencies.js",
    "jquery.currencies.min.js",
    "README.md"
  ],
  "license": "MIT",
  "browserslist": [
    "last 3 versions"
  ],
  "scripts": {
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && vite build && npm run build:min && npm run build:banner",
    "build:min": "vite build --config vite.min.config.mjs",
    "build:banner": "node -e \"import fs from 'fs';const pkg=JSON.parse(fs.readFileSync('./package.json','utf8'));const b='/*! Currencies Mepto v'+pkg.version+' \u2014 Mepto-integrated, jQuery-free */\\n';['dist/currencies.esm.min.js','dist/currencies.pkgd.min.js'].forEach(f=>{let c=fs.readFileSync(f,'utf8');if(!c.startsWith('/*!')){fs.writeFileSync(f,b+c);console.log('banner',f)}})\"",
    "dev": "vite build --watch",
    "lint": "npx eslint src --ext .js"
  },
  "author": {
    "name": "Caroline Schnapp (upstream) + oreoorbitz/currencies-mepto (mepto port)",
    "email": "mllegeorgesand@gmail.com",
    "url": "https://github.com/carolineschnapp"
  },
  "bugs": {
    "url": "https://github.com/oreoorbitz/currencies/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oreoorbitz/currencies.git"
  },
  "homepage": "https://github.com/oreoorbitz/currencies#readme",
  "peerDependencies": {
    "meptos": ">=2.0.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.24.0",
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "@rollup/plugin-babel": "^7.1.0",
    "esbuild": "^0.28.2",
    "terser": "^5.26.0",
    "vite": "^5.4.21"
  },
  "engines": {
    "node": ">=18"
  }
}
